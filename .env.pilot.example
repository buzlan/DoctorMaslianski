# Hosted Pilot publishable config for a physical-device Metro session.
# Copy to scripts/.env.pilot.local (gitignored). Do not commit real keys.
#
# Do not place this file at the project root as .env.pilot.local.
# Expo Metro require.context-loads root .env* files and treats *.local as JS.
#
# Used only by: npm run start:pilot-device
# Do not copy these values over .env.local — that file stays on 127.0.0.1
# for simulator / local Supabase.
#
# Expo's development virtual env merges `.env.local` on top of the shell.
# `start-pilot-device.sh` writes a temporary `.env.development.local` so
# hosted values win for that Metro session only.
#
# Never put service_role or sb_secret_ keys here.
# Never use http://127.0.0.1 or localhost.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Leave unset on Pilot. Publishable key is required.
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
