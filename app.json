{
  "expo": {
    "name": "Doctor Maslianski",
    "slug": "doctor-maslianski",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/patient/app_icon_primary.png",
    "scheme": "doctormaslianski",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "by.maslianski.app",
      "icon": "./assets/images/patient/app_icon_primary.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "by.maslianski.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/patient/app_icon_primary.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E8F2FA",
          "image": "./assets/images/patient/splash_logo.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Приложение использует камеру, чтобы вы могли добавить фото к вашему лечению.",
          "photosPermission": "Приложение использует фотоплёнку, чтобы вы могли добавить фото к вашему лечению.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ea96abd3-3954-434b-8b74-5ab91b2a6bee"
      }
    },
    "owner": "buzlik"
  }
}
