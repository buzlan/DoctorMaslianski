# Public Supabase config for the Expo app.
# Copy to .env.local for local / simulator. Do not commit real keys.
#
# Environments:
# - local: this file → .env.local → http://127.0.0.1:54321 (npx expo start)
# - pilot: copy .env.pilot.example → scripts/.env.pilot.local (npm run start:pilot-device)
# - production: reserved for TASK-039. Do not put Pilot keys there.
#
# After `npx supabase start` in doctor-maslianski-pilot:
#   npx supabase status -o env
# Map SUPABASE_URL → EXPO_PUBLIC_SUPABASE_URL
# Map the anon/publishable key → EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#
# Local URL notes:
# - iOS Simulator can use 127.0.0.1
# - Android Emulator will later need 10.0.2.2
# - physical devices use hosted Pilot values in scripts/.env.pilot.local, not this file
#
# Never put service_role or sb_secret_ keys in this app.
# Do not run `eas env:pull` into .env.local.

EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Fallback if the publishable key is unset (legacy local JWT anon key).
# If both are set, EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY wins.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
