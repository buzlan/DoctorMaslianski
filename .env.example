# Public Supabase config for the Expo app.
# Copy to .env.local. Do not commit real keys.
#
# After `npx supabase start` in doctor-maslianski-pilot:
#   npx supabase status -o env
# Map SUPABASE_URL → EXPO_PUBLIC_SUPABASE_URL
# Map the anon/publishable key → EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#
# Local URL notes (connectivity is TASK-031; this task only reads env):
# - iOS Simulator can use 127.0.0.1
# - Android Emulator will later need 10.0.2.2
# - physical devices need the host LAN address or hosted Supabase
#
# Never put service_role or sb_secret_ keys in this app.

EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Fallback if the publishable key is unset (legacy local JWT anon key).
# If both are set, EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY wins.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
